---
import SheetMeta from "@components/SheetMeta.astro";
import SectionHead from "@components/SectionHead.astro";
import { getContent } from "@data/i18n";

const w = getContent(Astro.currentLocale).work;
---

<section class="sheet" id="work" aria-labelledby="work-title">
  <SheetMeta />

  <SectionHead index={w.index} category={w.category} title={w.title} titleId="work-title">
    <p class="mt-2 text-sm text-muted">{w.company} · {w.period}</p>
  </SectionHead>

  <div class="mt-12 grid gap-6 md:grid-cols-[10rem_1fr]">
    <div class="hidden md:block" aria-hidden="true"></div>
    <div class="reveal max-w-3xl space-y-5 text-[clamp(1.125rem,1.7vw,1.5rem)] leading-[1.4] font-medium tracking-[-0.02em]">
      {/* about[1] is already the big Statement sheet above; the résumé uses both. */}
      <p>{w.about[0]}</p>
    </div>
  </div>

  <ol class="mt-16 border-t border-rule" data-stagger>
    {
      w.highlights.map((h, i) => (
        <li class="reveal group -mx-3 grid gap-3 rounded-2xl border-b border-rule px-3 py-7 transition-colors duration-300 hover:bg-white/60 md:-mx-5 md:grid-cols-[10rem_1fr] md:gap-6 md:px-5">
          <p class="text-xs tabular-nums text-faint transition-colors group-hover:text-ink">{String(i + 1).padStart(2, "0")}</p>
          <div class="grid gap-2 lg:grid-cols-[14rem_1fr] lg:gap-10">
            <h3 class="ink-shift text-[clamp(1.125rem,1.6vw,1.375rem)] font-semibold leading-tight tracking-[-0.03em]">{h.title}</h3>
            <p class="max-w-2xl text-[0.9375rem] leading-relaxed text-muted">{h.body}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <!-- Earlier roles: present, but deliberately quiet. -->
  <div class="mt-14 grid gap-6 md:grid-cols-[10rem_1fr]">
    <h3 class="text-xs font-medium uppercase tracking-[0.14em] text-faint">{w.earlierHeading}</h3>
    <ul class="space-y-5 text-[0.8125rem] text-muted">
      {
        w.earlier.map((e) => (
          <li class="max-w-2xl">
            <p>
              <span class="font-medium text-ink">{e.role}</span> · {e.company} · <span class="tabular-nums">{e.period}</span>
            </p>
            <p class="mt-1">{e.note}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
