---
import SheetMeta from "@components/SheetMeta.astro";
import { getContent } from "@data/i18n";

const t = getContent(Astro.currentLocale);
---

<nav class="sheet" aria-labelledby="index-heading">
  <SheetMeta />

  <div class="mt-16 grid gap-6 md:mt-24 md:grid-cols-[10rem_1fr]">
    <div>
      <h2 id="index-heading" class="text-lg font-semibold tracking-[-0.02em]">{t.index.heading}</h2>
      <span class="mt-1 block text-lg leading-none" aria-hidden="true">/</span>
    </div>

    <!-- Items fade to grey while another one is hovered, like the inactive page in print. -->
    <ol class="group/index grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.index.items.map((item) => (
          <li class="reveal">
            <a
              href={item.href}
              class="block transition-colors duration-200 group-hover/index:text-faint hover:!text-ink focus-visible:!text-ink"
            >
              <span class="numeral block">{item.index}</span>
              <span class="mt-6 block text-xl font-semibold tracking-[-0.02em]">{item.title}</span>
              <span class="mt-3 block space-y-1.5 text-[0.8125rem]">
                {item.entries.map((e) => (
                  <span class="block">{e}</span>
                ))}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</nav>
