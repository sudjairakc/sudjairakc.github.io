---
import { socials } from "@data/site";
import { getContent } from "@data/i18n";

const t = getContent(Astro.currentLocale);
---

<section class="relative overflow-hidden">
  <!-- Soft drifting AI orbs behind the hero -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="blob absolute left-[8%] top-[12%] h-72 w-72 rounded-full bg-sky-300/40 blur-3xl dark:bg-blue-500/25"
    >
    </div>
    <div
      class="blob absolute right-[10%] top-[6%] h-80 w-80 rounded-full bg-violet-300/40 blur-3xl dark:bg-violet-500/25"
      style="animation-delay: -5s;"
    >
    </div>
    <div
      class="blob absolute bottom-[2%] left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-emerald-300/30 blur-3xl dark:bg-emerald-500/18"
      style="animation-delay: -9s;"
    >
    </div>
  </div>

  <div class="section grid items-center gap-12 pt-32 lg:grid-cols-2 lg:pt-36">
    <!-- Copy -->
    <div class="reveal">
      <span class="eyebrow">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-400"></span>
        {t.common.role} · {t.common.location}
      </span>

      <h1
        class="mt-6 text-4xl font-extrabold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl"
        set:html={t.hero.headlineHtml}
      />

      <p
        class="mt-6 max-w-xl text-base leading-relaxed text-slate-600 dark:text-slate-300 sm:text-lg"
      >
        {t.hero.intro}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#projects" class="btn-primary">{t.hero.exploreBtn}</a>
        <a
          href={socials.github}
          target="_blank"
          rel="noopener"
          class="btn-ghost">{t.hero.viewGithub}</a
        >
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-2">
        <span class="text-sm text-slate-500 dark:text-slate-400">
          {t.hero.jumpTo}
        </span>
        {
          t.hero.jumpChips.map((chip) => (
            <a href="#projects" class="pill">
              {chip}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Floating glass dashboard mockup: previews of the 3 projects -->
    <div class="reveal relative mx-auto w-full max-w-md lg:max-w-none">
      <!-- Portfolio profile card -->
      <div class="glass float-slow relative z-20 p-5">
        <div class="flex items-center gap-3">
          <div
            class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-sky-400 to-violet-500 font-mono text-sm font-bold text-white"
          >
            {"</>"}
          </div>
          <div>
            <p class="font-mono text-sm font-semibold">&lt; ChaichanaS /&gt;</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              Senior Full-Stack Developer · Thailand
            </p>
          </div>
        </div>
        <div class="mt-4 flex flex-wrap gap-1.5">
          {
            ["React", "Go", "TypeScript", "Node.js"].map((s) => (
              <span class="pill !px-2.5 !py-1 !text-[0.7rem]">{s}</span>
            ))
          }
        </div>
      </div>

      <!-- Election mini chart card -->
      <div
        class="glass float-slower relative z-10 -mt-4 ml-auto w-[78%] p-4"
        style="animation-delay: -3s;"
      >
        <div class="flex items-center justify-between">
          <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">
            BKK Election
          </p>
          <p class="font-mono text-xs font-bold">65 → 69</p>
        </div>
        <div class="mt-3 flex items-end gap-1.5" aria-hidden="true">
          {
            [40, 65, 30, 80, 55, 70, 45, 90, 60, 35].map((h, i) => (
              <span
                class="flex-1 rounded-t"
                style={`height:${h * 0.5}px; background: linear-gradient(to top, ${
                  i % 3 === 0
                    ? "#fb923c"
                    : i % 3 === 1
                      ? "#38bdf8"
                      : "#34d399"
                }, ${
                  i % 3 === 0
                    ? "#fdba74"
                    : i % 3 === 1
                      ? "#7dd3fc"
                      : "#6ee7b7"
                });`}
              />
            ))
          }
        </div>
        <p class="mt-2 text-[0.7rem] text-slate-500 dark:text-slate-400">
          50 districts · 2022 → 2026
        </p>
      </div>

      <!-- SyncTune music room card -->
      <div
        class="glass float-slow relative z-30 -mt-6 w-[70%] p-4"
        style="animation-delay: -6s;"
      >
        <div class="flex items-center gap-3">
          <div
            class="relative flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-fuchsia-500 to-cyan-400 text-white shadow-lg shadow-fuchsia-500/40"
          >
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-fuchsia-400/40"
            ></span>
            <svg viewBox="0 0 24 24" class="relative h-4 w-4 fill-current"
              ><path d="M8 5v14l11-7z"></path></svg
            >
          </div>
          <div class="flex-1">
            <p class="text-xs font-semibold">SyncTune · Room 482913</p>
            <div class="mt-1.5 flex items-end gap-0.5" aria-hidden="true">
              {
                [6, 12, 8, 16, 10, 14, 7, 13, 9, 15, 6, 11].map((h, i) => (
                  <span
                    class="w-1 rounded-full bg-gradient-to-t from-fuchsia-500 to-cyan-400 float-slow"
                    style={`height:${h}px; animation-delay:-${i * 0.2}s;`}
                  />
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
