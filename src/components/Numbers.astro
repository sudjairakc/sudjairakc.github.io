---
// Spec-sheet band: giant numbers, tiny labels, on an ink-black glass sheet.
// Numbers zoom in as they scroll into view ([data-zoom]) and count up ([data-count]).
import { getContent } from "@data/i18n";

const t = getContent(Astro.currentLocale).numbers;

// "1,200+" → count to 1200, then append "+". Non-numeric values ("3×", "27 → 4") stay static.
const parse = (v: string) => {
  const m = v.match(/^([\d,]+)(\D*)$/);
  return m ? { count: m[1].replace(/,/g, ""), suffix: m[2] } : null;
};
---

<section class="sheet sheet-ink" aria-labelledby="numbers-heading">
  <div class="py-[clamp(2.5rem,8vw,6rem)]">
    <p class="text-xs font-medium uppercase tracking-[0.14em] text-white/50">{t.eyebrow}</p>
    <h2 id="numbers-heading" class="display-lg mt-4 text-white">{t.heading}</h2>

    <dl class="mt-[clamp(3rem,8vw,6rem)] grid gap-x-10 gap-y-[clamp(2.5rem,6vw,4.5rem)] sm:grid-cols-2 lg:grid-cols-3">
      {
        t.items.map((item) => {
          const n = parse(item.value);
          return (
            <div class="border-t border-white/15 pt-6" data-zoom>
              <dt class="sr-only">{item.label}</dt>
              <dd
                class="display-num text-white"
                data-count={n?.count}
                data-suffix={n?.suffix || undefined}
              >
                {item.value}
              </dd>
              <dd class="mt-3 max-w-[16rem] text-sm leading-snug text-white/55" aria-hidden="true">
                {item.label}
              </dd>
            </div>
          );
        })
      }
    </dl>
  </div>
</section>
