  },
  {
    label: "LinkedIn",
    href: socials.linkedin,
    external: true,
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
  {
    label: "GitLab",
    href: socials.gitlab,
    external: true,
    path: "m23.6 9.593-.033-.086L20.3.98a.851.851 0 0 0-.336-.405.875.875 0 0 0-1 .054.875.875 0 0 0-.29.44l-2.207 6.75H7.535L5.327 1.07a.86.86 0 0 0-.29-.44.875.875 0 0 0-1-.054.855.855 0 0 0-.336.405L.434 9.502l-.033.086a6.066 6.066 0 0 0 2.012 7.01l.011.008.03.022 4.977 3.727 2.462 1.863 1.5 1.133a1.01 1.01 0 0 0 1.22 0l1.5-1.133 2.462-1.863 5.008-3.749.012-.01a6.067 6.067 0 0 0 2.005-7.003z",
  },
  {
    label: "Facebook",
    href: socials.facebook,
    external: true,
    path: "M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z",
  },
  {
    label: "Email",
    href: `mailto:${socials.email}`,
    external: false,
    path: "M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67zM22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908z",
  },
];
---

<footer class="border-t border-slate-900/10 dark:border-white/10">
  <div
    class="section !py-10 flex flex-col items-center gap-6 sm:flex-row sm:items-center sm:justify-between"
  >
    <!-- Left: logo + role/location -->
    <div class="text-center sm:text-left">
      <a
        href="#top"
        class="group inline-flex items-center gap-1 font-mono text-sm font-medium tracking-tight"
        aria-label={`${site.handle} — back to top`}
      >
        <span class="text-slate-400 dark:text-slate-500">&lt;</span>
        <span class="gradient-text">{site.handle}</span>
        <span class="text-slate-400 dark:text-slate-500">/&gt;</span>
      </a>
      <p class="mt-1.5 text-sm text-slate-500 dark:text-slate-400">
        {t.common.role} · {t.common.location}
      </p>
    </div>

    <!-- Right: social icons -->
    <nav aria-label="Social links" class="flex items-center gap-1.5">
      {
        socialLinks.map((s) => (
          <a
            href={s.href}
            aria-label={s.label}
            {...(s.external
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
            class="grid h-9 w-9 place-items-center rounded-full text-slate-500 transition-colors hover:bg-slate-900/5 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-white/10 dark:hover:text-white"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={s.path} />
            </svg>
          </a>
        ))
      }
    </nav>
  </div>

  <div class="section !py-0 !pb-8">
    <p class="text-center text-xs text-slate-400 dark:text-slate-500 sm:text-left">
      {t.footer.copyright}
    </p>
  </div>
</footer>
