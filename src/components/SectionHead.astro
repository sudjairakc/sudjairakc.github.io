---
// Big numeral + category, shared by every content sheet.
interface Props {
  index: string;
  category: string;
  title: string;
  titleId: string;
}
const { index, category, title, titleId } = Astro.props;
---

<div class="mt-16 grid gap-6 md:mt-24 md:grid-cols-[10rem_1fr]">
  <p class="numeral" aria-hidden="true">{index}</p>
  <div class="md:pt-2">
    <p class="text-xs font-medium uppercase tracking-[0.14em] text-muted">{category}</p>
    <h2 id={titleId} class="mt-3 text-[clamp(1.75rem,4vw,2.75rem)] font-semibold leading-[1.1] tracking-[-0.035em]">
      {title}
    </h2>
    <slot />
  </div>
</div>
