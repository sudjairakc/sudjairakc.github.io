---
const points = [
  "Compares 50 Bangkok districts between 2022 and 2026.",
  "Shows district-level winner changes and party/group movement.",
  "Includes Sankey, bar charts, grid map, dumbbell chart, matrix, and sortable table.",
  "Built with Astro, TypeScript, vanilla DOM, and SVG without a heavy runtime framework.",
];

const stats = [
  { value: "50", label: "districts" },
  { value: "65 → 69", label: "seats compared" },
  { value: "27", label: "changed hands" },
  { value: "32", label: "repeat winners" },
];

// Pastel "party" palette — ~6 colors distributed across 50 district cells.
const partyColors = [
  "#fb923c", // orange
  "#38bdf8", // sky
  "#34d399", // emerald
  "#a78bfa", // violet
  "#f472b6", // pink
  "#94a3b8", // slate
];

// A hand-tuned distribution so it reads as party-coded districts (not a flat pattern).
const districtMap = [
  0, 0, 1, 1, 2, 0, 3, 1, 4, 2,
  1, 0, 0, 2, 3, 1, 1, 5, 0, 2,
  3, 1, 2, 0, 0, 4, 1, 1, 2, 3,
  0, 2, 5, 1, 0, 3, 2, 1, 0, 4,
  1, 0, 2, 3, 1, 5, 0, 2, 1, 3,
];

// Paired mini bar chart: 2565 (65) vs 2569 (69) across a few groups.
const bars = [
  { a: 58, b: 72 },
  { a: 74, b: 61 },
  { a: 42, b: 88 },
  { a: 66, b: 70 },
];
---

<section class="section reveal grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
  <!-- LEFT: editorial copy -->
  <div>
    <span class="eyebrow">
      <span class="inline-block h-2 w-2 rounded-full bg-orange-400"></span>
      02 · Data Visualization
    </span>

    <h2
      class="mt-6 text-3xl font-extrabold leading-[1.1] tracking-tight sm:text-4xl lg:text-[2.75rem]"
    >
      Turning complex election results into
      <span class="gradient-text">visual stories</span> people can scan.
    </h2>

    <p
      class="mt-6 max-w-xl text-base leading-relaxed text-slate-600 dark:text-slate-300"
    >
      This project compares Bangkok council election results from 2022 to 2026
      across all 50 districts. It translates political and district-level changes
      into interactive visualizations, including party seat comparison, district
      maps, Sankey-style transitions, searchable tables, and score movement
      charts.
    </p>

    <ul class="mt-8 space-y-3.5">
      {
        points.map((point) => (
          <li class="flex items-start gap-3">
            <span
              class="mt-1 h-2.5 w-2.5 flex-none rounded-sm bg-gradient-to-br from-orange-400 via-sky-400 to-emerald-400 shadow-sm"
              aria-hidden="true"
            />
            <span class="text-sm leading-relaxed text-slate-600 dark:text-slate-300">
              {point}
            </span>
          </li>
        ))
      }
    </ul>

    <!-- BIG editorial stat numbers -->
    <dl class="mt-9 grid grid-cols-2 gap-x-6 gap-y-6 sm:grid-cols-4">
      {
        stats.map((stat) => (
          <div>
            <dt class="text-3xl font-extrabold tracking-tight sm:text-[2.1rem]">
              {stat.value}
            </dt>
            <dd class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">
              {stat.label}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a
        href="https://sudjairakc.github.io/bkk-election-69-results-compare"
        target="_blank"
        rel="noopener"
        class="btn-primary"
      >
        Open Website
      </a>
      <a
        href="https://github.com/sudjairakc/bkk-election-69-results-compare"
        target="_blank"
        rel="noopener"
        class="btn-ghost"
      >
        View Repository
      </a>
    </div>
  </div>

  <!-- RIGHT: data-viz dashboard mockup -->
  <div class="relative mx-auto w-full max-w-md lg:max-w-none">
    <!-- Soft pastel multi-color glow behind the mockup -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div
        class="blob absolute -left-8 top-2 h-56 w-56 rounded-full bg-orange-300/35 blur-3xl dark:bg-orange-500/20"
      >
      </div>
      <div
        class="blob absolute right-0 top-1/3 h-52 w-52 rounded-full bg-sky-300/35 blur-3xl dark:bg-sky-500/20"
        style="animation-delay: -5s;"
      >
      </div>
      <div
        class="blob absolute -bottom-6 left-1/4 h-56 w-56 rounded-full bg-emerald-300/30 blur-3xl dark:bg-emerald-500/18"
        style="animation-delay: -9s;"
      >
      </div>
    </div>

    <div class="glass float-slow relative p-6 sm:p-7" aria-hidden="true">
      <!-- Dashboard header -->
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-semibold">Bangkok Council</p>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            2565 → 2569 · 50 เขต
          </p>
        </div>
        <div class="flex gap-1.5">
          {
            partyColors.map((c) => (
              <span
                class="h-2.5 w-2.5 rounded-full"
                style={`background:${c}`}
              />
            ))
          }
        </div>
      </div>

      <!-- 5×10 district grid (50 party-coded cells) -->
      <div class="mt-5">
        <p class="mb-2 text-[0.7rem] font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">
          50 เขต · District map
        </p>
        <div class="grid grid-cols-10 gap-1.5">
          {
            districtMap.map((idx) => (
              <span
                class="aspect-square rounded-[4px]"
                style={`background:${partyColors[idx]};opacity:0.85`}
              />
            ))
          }
        </div>
      </div>

      <!-- Sankey-style flow lines -->
      <div class="mt-5">
        <p class="mb-1 text-[0.7rem] font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">
          Party transitions
        </p>
        <svg
          viewBox="0 0 320 84"
          class="w-full"
          preserveAspectRatio="none"
        >
          <!-- left nodes -->
          <rect x="4" y="8" width="6" height="16" rx="3" fill="#fb923c" opacity="0.85" />
          <rect x="4" y="34" width="6" height="16" rx="3" fill="#38bdf8" opacity="0.85" />
          <rect x="4" y="60" width="6" height="16" rx="3" fill="#34d399" opacity="0.85" />
          <!-- right nodes -->
          <rect x="310" y="12" width="6" height="18" rx="3" fill="#38bdf8" opacity="0.85" />
          <rect x="310" y="38" width="6" height="18" rx="3" fill="#a78bfa" opacity="0.85" />
          <rect x="310" y="60" width="6" height="14" rx="3" fill="#f472b6" opacity="0.85" />
          <!-- thin curved bezier flows -->
          <path d="M10 16 C 120 16, 200 21, 310 21" fill="none" stroke="#fb923c" stroke-width="3" opacity="0.4" />
          <path d="M10 42 C 120 42, 200 47, 310 47" fill="none" stroke="#38bdf8" stroke-width="4" opacity="0.4" />
          <path d="M10 68 C 120 68, 200 47, 310 47" fill="none" stroke="#34d399" stroke-width="3" opacity="0.4" />
          <path d="M10 42 C 130 42, 210 67, 310 67" fill="none" stroke="#a78bfa" stroke-width="2.5" opacity="0.4" />
        </svg>
      </div>

      <!-- Mini paired bar chart: 65 vs 69 -->
      <div class="mt-4 flex items-end justify-between gap-4">
        <div class="flex flex-1 items-end gap-3">
          {
            bars.map((bar) => (
              <div class="flex flex-1 items-end justify-center gap-1">
                <span
                  class="w-2.5 rounded-t bg-slate-400/70 dark:bg-slate-500/70"
                  style={`height:${bar.a * 0.5}px`}
                />
                <span
                  class="w-2.5 rounded-t bg-sky-400/90"
                  style={`height:${bar.b * 0.5}px`}
                />
              </div>
            ))
          }
        </div>
        <div class="flex flex-col items-end leading-none">
          <span class="text-2xl font-extrabold text-slate-400 dark:text-slate-500">65</span>
          <span class="mt-1 text-2xl font-extrabold gradient-text">69</span>
        </div>
      </div>

      <!-- Faux search-table header row -->
      <div class="mt-5 overflow-hidden rounded-xl border border-slate-200/60 dark:border-white/10">
        <div class="grid grid-cols-[1.4fr_1fr_1fr] gap-2 bg-white/40 px-3 py-2 text-[0.68rem] font-semibold uppercase tracking-wide text-slate-500 dark:bg-white/5 dark:text-slate-400">
          <span>District</span>
          <span class="text-right">2565</span>
          <span class="text-right">2569</span>
        </div>
        <div class="divide-y divide-slate-200/50 dark:divide-white/5">
          {
            [
              { d: "Bang Rak", a: "#38bdf8", b: "#fb923c" },
              { d: "Din Daeng", a: "#34d399", b: "#34d399" },
              { d: "Lat Phrao", a: "#a78bfa", b: "#f472b6" },
            ].map((row) => (
              <div class="grid grid-cols-[1.4fr_1fr_1fr] items-center gap-2 px-3 py-1.5 text-[0.7rem] text-slate-600 dark:text-slate-300">
                <span>{row.d}</span>
                <span class="flex justify-end">
                  <span class="h-2.5 w-2.5 rounded-full" style={`background:${row.a}`} />
                </span>
                <span class="flex justify-end">
                  <span class="h-2.5 w-2.5 rounded-full" style={`background:${row.b}`} />
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
