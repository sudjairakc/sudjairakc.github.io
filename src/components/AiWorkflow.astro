---
// AI workflow / build philosophy section (brief §6.7).
import { getContent } from "@data/i18n";

const t = getContent(Astro.currentLocale);

// Per-card accent glow, cycling through the AI palette.
const accents = [
  "from-sky-300/40 to-blue-300/30",
  "from-violet-300/40 to-fuchsia-300/30",
  "from-cyan-300/40 to-sky-300/30",
  "from-emerald-300/40 to-teal-300/30",
];
---

<section id="ai-focus" class="section reveal">
  <!-- Heading -->
  <div class="max-w-3xl">
    <span class="eyebrow">{t.ai.eyebrow}</span>
    <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl" set:html={t.ai.headingHtml} />
    <p class="mt-5 text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-400">
      {t.ai.intro}
    </p>
  </div>

  <!-- Philosophy cards -->
  <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      t.ai.philosophy.map((item, i) => (
        <article class="glass group relative isolate overflow-hidden p-6 transition-transform duration-300 hover:-translate-y-1">
          {/* Subtle per-card accent glow */}
          <div
            aria-hidden="true"
            class={`pointer-events-none absolute -right-10 -top-10 -z-10 h-32 w-32 rounded-full bg-gradient-to-br ${accents[i % accents.length]} opacity-70 blur-2xl transition-opacity duration-300 group-hover:opacity-100`}
          />

          {/* Index */}
          <span class="font-mono text-sm font-semibold tracking-widest text-slate-400 dark:text-slate-500">
            {String(i + 1).padStart(2, "0")}
          </span>

          {/* Title */}
          <h3 class="mt-4 text-lg font-semibold tracking-tight text-slate-900 dark:text-white">
            {item.title}
          </h3>

          {/* Caption */}
          <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
            {item.caption}
          </p>

          {/* Applies to */}
          <div class="mt-5">
            <span class="pill text-xs">
              <span class="text-slate-400 dark:text-slate-500">{t.ai.appliesTo}</span>
              {item.applies}
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
