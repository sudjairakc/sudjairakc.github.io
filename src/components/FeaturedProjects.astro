---
// Featured projects grid (brief §6). Three showcase cards.
// Structural project data comes from @data/projects; display text is localized.
import { projects } from "@data/projects";
import { getContent } from "@data/i18n";
import ProjectCard from "./ProjectCard.astro";

const t = getContent(Astro.currentLocale);

// Merge locale-independent structure with localized text (parallel by index).
const cards = projects.map((project, i) => {
  const text = t.projects[i];
  return {
    ...project,
    eyebrow: text.eyebrow,
    title: text.title,
    shortTitle: text.shortTitle,
    description: text.description,
    repos: project.repos.map((repo, j) => ({
      url: repo.url,
      label: text.repoLabels[j] ?? repo.label,
    })),
  };
});
---

<section id="projects" class="section reveal">
  {/* Heading block */}
  <div class="max-w-3xl">
    <span class="eyebrow">{t.featured.eyebrow}</span>
    <h2
      class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl"
      set:html={t.featured.headingHtml}
    />
    <p class="mt-4 text-base leading-relaxed text-slate-500 dark:text-slate-400">
      {t.featured.intro}
    </p>
  </div>

  {/* Grid */}
  <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3">
    {
      cards.map((project, i) => (
        <div class="reveal h-full" style={`transition-delay:${i * 120}ms`}>
          <ProjectCard project={project} />
        </div>
      ))
    }
  </div>
</section>
