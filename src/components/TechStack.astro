---
// Tech stack cloud, grouped (brief §6.8).
import { techGroups } from "@data/site";
---

<section id="stack" class="section reveal">
  <!-- Heading -->
  <div class="max-w-3xl">
    <span class="eyebrow">Tech stack</span>
    <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl">
      The <span class="gradient-text">tools</span> behind the work.
    </h2>
  </div>

  <!-- Group cards -->
  <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2">
    {
      techGroups.map((group) => (
        <article class="glass relative isolate overflow-hidden p-6 sm:p-7">
          {/* Soft group glow */}
          <div
            aria-hidden="true"
            class={`pointer-events-none absolute -left-8 -top-8 -z-10 h-40 w-40 rounded-full bg-gradient-to-br ${group.glow} opacity-80 blur-3xl`}
          />

          {/* Label */}
          <h3 class="text-lg font-semibold tracking-tight text-slate-900 dark:text-white">
            {group.label}
          </h3>

          {/* Items */}
          <ul class="mt-5 flex flex-wrap gap-2.5">
            {group.items.map((item) => (
              <li>
                <span class="pill">{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
