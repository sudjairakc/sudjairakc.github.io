---
import SheetMeta from "@components/SheetMeta.astro";
import SectionHead from "@components/SectionHead.astro";
import type { ProjectSection } from "@data/content/types";

interface Props {
  project: ProjectSection;
  id: string;
}
const { project: p, id } = Astro.props;
const titleId = `${id}-title`;
---

<section class="sheet" id={id} aria-labelledby={titleId}>
  <SheetMeta />

  <SectionHead index={p.index} category={p.category} title={p.title} titleId={titleId} />

  <div class="mt-12 grid gap-6 md:grid-cols-[10rem_1fr]">
    <div class="hidden md:block" aria-hidden="true"></div>
    <div class="reveal max-w-2xl">
      <p class="text-[0.9375rem] leading-relaxed">{p.intro}</p>

      {
        p.stats.length > 0 && (
          <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4">
            {p.stats.map((s) => (
              <div>
                <dt class="sr-only">{s.label}</dt>
                <dd class="text-[clamp(1.75rem,4vw,2.5rem)] font-medium leading-none tracking-[-0.05em] tabular-nums">
                  {s.value}
                </dd>
                <dd class="mt-2 text-xs text-muted" aria-hidden="true">{s.label}</dd>
              </div>
            ))}
          </dl>
        )
      }

      <ul class="mt-12 space-y-3 border-t border-rule pt-6 text-sm leading-relaxed text-muted">
        {p.points.map((pt) => <li class="grid grid-cols-[1.25rem_1fr]"><span aria-hidden="true">—</span>{pt}</li>)}
      </ul>

      <p class="mt-8 text-xs text-faint">{p.stack.join(" · ")}</p>

      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium">
        {
          p.links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener" class="underline-link">
                {l.label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
