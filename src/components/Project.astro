---
import SheetMeta from "@components/SheetMeta.astro";
import SectionHead from "@components/SectionHead.astro";
import type { ProjectSection } from "@data/content/types";

interface Props {
  project: ProjectSection;
  id: string;
}
const { project: p, id } = Astro.props;
const titleId = `${id}-title`;
---

<section class="sheet" id={id} aria-labelledby={titleId}>
  <SheetMeta />

  <SectionHead index={p.index} category={p.category} title={p.title} titleId={titleId} />

  <div class="mt-12 grid gap-6 md:grid-cols-[10rem_1fr]">
    <div class="hidden md:block" aria-hidden="true"></div>
    <div class="reveal max-w-2xl">
      <p class="text-[0.9375rem] leading-relaxed">{p.intro}</p>

      {
        p.stats.length > 0 && (
          <dl class="mt-12 grid grid-cols-2 gap-3 lg:grid-cols-4" data-stagger>
            {p.stats.map((s) => (
              <div class="reveal glass-chip rounded-2xl p-4">
                <dt class="sr-only">{s.label}</dt>
                <dd
                  class="text-[clamp(1.5rem,3vw,2.25rem)] font-medium leading-none tracking-[-0.05em] whitespace-nowrap tabular-nums"
                  data-count={/^\d+$/.test(s.value) ? s.value : undefined}
                >
                  {s.value}
                </dd>
                <dd class="mt-2 text-xs text-muted" aria-hidden="true">{s.label}</dd>
              </div>
            ))}
          </dl>
        )
      }

      <ul class="mt-12 space-y-3 border-t border-rule pt-6 text-sm leading-relaxed text-muted">
        {p.points.map((pt) => <li class="grid grid-cols-[1.25rem_1fr]"><span aria-hidden="true">—</span>{pt}</li>)}
      </ul>

      <p class="mt-8 text-xs text-faint">{p.stack.join(" · ")}</p>

      <ul class="mt-8 flex flex-wrap gap-2.5 text-sm font-medium">
        {
          p.links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener" class="group glass-chip inline-flex items-center gap-1.5 rounded-full px-4 py-2 transition-transform duration-300 hover:-translate-y-0.5">
                {l.label} <span class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
