---
// One project shown as a frosted glass card with a themed mini mockup.
import type { Project } from "@data/projects";
import { getContent } from "@data/i18n";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const t = getContent(Astro.currentLocale);
---

<article
  class="project-card glass relative isolate flex h-full flex-col overflow-hidden p-6 sm:p-7"
>
  {/* ── Header: soft accent glow + themed mini mockup ─────────────────── */}
  <div
    class="relative flex h-32 items-center justify-center overflow-hidden rounded-2xl border border-white/50 bg-white/30 dark:border-white/10 dark:bg-white/5"
  >
    {/* Accent glow orb */}
    <div
      aria-hidden="true"
      class={`pointer-events-none absolute -right-6 -top-8 h-32 w-32 rounded-full bg-gradient-to-br ${project.accent} opacity-90 blur-2xl`}
    >
    </div>
    <div
      aria-hidden="true"
      class={`pointer-events-none absolute -left-8 -bottom-10 h-28 w-28 rounded-full bg-gradient-to-br ${project.accent} opacity-70 blur-2xl`}
    >
    </div>

    {
      /* ── blue-slate: mini developer profile card ─────────────────── */
      project.theme === "blue-slate" && (
        <div
          aria-hidden="true"
          class="relative z-10 w-40 rounded-xl border border-white/60 bg-white/90 p-3 shadow-lg dark:border-white/10 dark:bg-slate-900/85"
        >
          <div class="flex items-center gap-2">
            <div class="h-6 w-6 rounded-full bg-gradient-to-br from-sky-300 to-slate-400" />
            <code class="font-mono text-[11px] font-semibold text-slate-700 dark:text-slate-200">
              {"< ChaichanaS />"}
            </code>
          </div>
          <div class="mt-2.5 flex flex-wrap gap-1.5">
            {["React", "Go", "TS"].map((s, i) => (
              <span class="flex items-center gap-1 rounded-full bg-slate-200/70 px-1.5 py-0.5 text-[9px] font-medium text-slate-600 dark:bg-white/10 dark:text-slate-300">
                <span
                  class="h-1.5 w-1.5 rounded-full"
                  style={`background:${["#38bdf8", "#34d399", "#a78bfa"][i]}`}
                />
                {s}
              </span>
            ))}
          </div>
        </div>
      )
    }

    {
      /* ── civic-pastel: pastel grid + sankey lines ────────────────── */
      project.theme === "civic-pastel" && (
        <div aria-hidden="true" class="relative z-10 flex items-center gap-3">
          <div class="grid grid-cols-5 gap-1">
            {Array.from({ length: 50 }).map((_, i) => (
              <span
                class="h-2 w-2 rounded-[3px]"
                style={`background:${["#fdba74", "#7dd3fc", "#6ee7b7", "#c4b5fd", "#fca5a5"][i % 5]};opacity:${0.55 + ((i * 7) % 5) * 0.09}`}
              />
            ))}
          </div>
          <svg width="52" height="70" viewBox="0 0 52 70" fill="none">
            <path
              d="M2 12 C26 12 26 24 50 24"
              stroke="#fdba74"
              stroke-width="3"
              stroke-linecap="round"
              opacity="0.7"
            />
            <path
              d="M2 34 C26 34 26 46 50 46"
              stroke="#7dd3fc"
              stroke-width="3"
              stroke-linecap="round"
              opacity="0.7"
            />
            <path
              d="M2 56 C26 56 26 60 50 60"
              stroke="#6ee7b7"
              stroke-width="3"
              stroke-linecap="round"
              opacity="0.7"
            />
          </svg>
        </div>
      )
    }

    {
      /* ── music-glow: mini media player ───────────────────────────── */
      project.theme === "music-glow" && (
        <div
          aria-hidden="true"
          class="relative z-10 flex w-44 flex-col items-center gap-2.5 rounded-xl border border-white/50 bg-white/85 p-3 dark:border-white/10 dark:bg-slate-900/80"
        >
          <div class="flex w-full items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-fuchsia-400 to-cyan-400 text-xs text-white shadow-[0_0_16px_rgba(217,70,239,0.6)]">
              ▶
            </span>
            <div class="flex h-8 flex-1 items-end gap-1">
              {[10, 22, 14, 28, 18].map((h, i) => (
                <span
                  class="wave-bar w-1.5 rounded-full bg-gradient-to-t from-cyan-400 to-fuchsia-400"
                  style={`height:${h}px;animation-delay:${i * 0.15}s`}
                />
              ))}
            </div>
          </div>
          <div class="flex w-full items-center gap-1.5">
            <span class="h-1 flex-1 rounded-full bg-slate-300/70 dark:bg-white/15" />
            <span class="h-1 w-3 rounded-full bg-fuchsia-400/80" />
          </div>
        </div>
      )
    }
  </div>

  {/* ── Body ──────────────────────────────────────────────────────────── */}
  <div class="mt-5 flex flex-1 flex-col">
    <span class="pill self-start">{project.eyebrow}</span>

    <h3
      class="mt-3 text-xl font-semibold tracking-tight text-slate-900 dark:text-white"
    >
      {project.title}
    </h3>

    <p class="mt-2 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
      {project.description}
    </p>

    {/* Stack */}
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        project.stack.map((tech) => (
          <li>
            <span class="pill">{tech}</span>
          </li>
        ))
      }
    </ul>

    {/* Actions */}
    <div class="mt-6 flex flex-wrap gap-3 pt-1">
      <a
        class="btn-primary"
        href={project.website}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.projectCard.openWebsite}
      </a>
      {
        project.repos.map((repo) => (
          <a
            class="btn-ghost"
            href={repo.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {repo.label}
          </a>
        ))
      }
    </div>
  </div>
</article>

<style>
  .project-card {
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 32px 90px rgba(15, 23, 42, 0.16);
  }
  :global(html.dark) .project-card:hover {
    box-shadow: 0 32px 90px rgba(0, 0, 0, 0.45);
  }

  .wave-bar {
    animation: wave 1.1s ease-in-out infinite;
    transform-origin: bottom;
  }
  @keyframes wave {
    0%,
    100% {
      transform: scaleY(0.5);
    }
    50% {
      transform: scaleY(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wave-bar {
      animation: none;
    }
  }
</style>
