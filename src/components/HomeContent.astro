---
// Shared page body for every locale. Section components read the active
// language from Astro.currentLocale (set by the route), so this is identical
// across / (en) and /th/.
import Cover from "@components/Cover.astro";
import Profile from "@components/Profile.astro";
import Index from "@components/Index.astro";
import Work from "@components/Work.astro";
import Project from "@components/Project.astro";
import Contact from "@components/Contact.astro";
import { getContent } from "@data/i18n";

const t = getContent(Astro.currentLocale);
---

<Cover />
<main>
  <Profile />
  <Index />
  <Work />
  <Project project={t.election} id="data-visualization" />
  <Project project={t.synctune} id="real-time" />
</main>
<Contact />
