---
import { site, socials } from "@data/site";

const links = [
  { label: "Projects", href: "#projects" },
  { label: "AI Focus", href: "#ai-focus" },
  { label: "Stack", href: "#stack" },
  { label: "Contact", href: "#contact" },
];
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="mx-auto mt-4 w-full max-w-5xl px-4 sm:px-6">
    <nav
      aria-label="Primary"
      class="glass !rounded-full flex items-center justify-between gap-3 px-4 py-2.5 shadow-lg shadow-slate-900/5"
    >
      <!-- Logo -->
      <a
        href="#top"
        class="group flex items-center gap-1 font-mono text-sm sm:text-base font-medium whitespace-nowrap tracking-tight"
        aria-label={`${site.handle} — back to top`}
      >
        <span class="text-slate-400 dark:text-slate-500">&lt;</span>
        <span class="gradient-text">{site.handle}</span>
        <span class="text-slate-400 dark:text-slate-500">/&gt;</span>
      </a>

      <!-- Desktop nav links -->
      <ul class="hidden md:flex items-center gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded-full px-3.5 py-1.5 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-900/5 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Right controls -->
      <div class="flex items-center gap-2">
        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle dark mode"
          class="grid h-9 w-9 place-items-center rounded-full border border-slate-900/10 text-slate-600 transition-colors hover:bg-slate-900/5 hover:text-slate-900 dark:border-white/10 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white"
        >
          <!-- Sun (shown in dark mode) -->
          <svg
            class="hidden h-5 w-5 dark:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
            ></path>
          </svg>
          <!-- Moon (shown in light mode) -->
          <svg
            class="block h-5 w-5 dark:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        <!-- Desktop CTA -->
        <a
          href={socials.github}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary hidden md:inline-flex text-sm"
        >
          View GitHub
        </a>

        <!-- Mobile CTA (icon) -->
        <a
          href={socials.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View GitHub profile"
          class="btn-primary md:hidden !p-0 grid h-9 w-9 place-items-center !rounded-full"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.523 2 12 2z"
            ></path>
          </svg>
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", () => {
      const root = document.documentElement;
      const isDark = root.classList.toggle("dark");
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch (e) {}
    });
  })();
</script>
