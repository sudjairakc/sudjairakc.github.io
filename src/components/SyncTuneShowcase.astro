---
// Project Deep-Dive 03 — SyncTune (brief §6.6).
// Two-column: text + a large glass media-player mockup. Playful violet/cyan/pink glow.

const keyPoints = [
  "Real-time shared music queue with YouTube playback.",
  "No account required: users join with a name and room ID.",
  "Chat, online users, queue history, sound pad, vote modal, and voice PTT.",
  "Backend handles multi-room state, WebSocket broadcasting, Redis persistence, and WebRTC signaling.",
];

// Equalizer bar heights (%). Repeats give a wave-like silhouette.
const bars = [38, 62, 88, 54, 72, 96, 44, 80, 60, 92, 48, 70, 86, 52, 64, 90, 40, 74];

// Mini queue rows: [title placeholder, up-votes, thumb gradient]
const queue = [
  { title: "lofi beats — chill mix", votes: 12, from: "from-violet-400", to: "to-fuchsia-400" },
  { title: "synthwave night drive", votes: 8, from: "from-cyan-400", to: "to-violet-400" },
  { title: "deep focus — vol. 2", votes: 5, from: "from-fuchsia-400", to: "to-pink-400" },
];

const avatars = [
  "from-violet-400 to-fuchsia-500",
  "from-cyan-400 to-sky-500",
  "from-pink-400 to-rose-500",
  "from-emerald-400 to-teal-500",
];
---

<section id="synctune" class="section reveal">
  <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <!-- ── LEFT: text ─────────────────────────────────────────────────── -->
    <div>
      <span class="eyebrow">03 · Real-time Collaboration</span>

      <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl">
        A shared music room powered by
        <span class="gradient-text">WebSocket</span>, WebRTC, and Redis.
      </h2>

      <p class="mt-5 text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-400">
        SyncTune is an experimental real-time music collaboration app. Users can
        create a room, add YouTube videos to a shared queue, chat with others,
        vote on playback actions, trigger sound effects, and use push-to-talk
        voice. The frontend is built with Svelte and Vite, while the backend uses
        Go, WebSocket broadcasting, and Redis as the single source of truth.
      </p>

      <!-- Key points -->
      <ul class="mt-8 space-y-4">
        {
          keyPoints.map((point) => (
            <li class="flex items-start gap-3">
              <span
                aria-hidden="true"
                class="mt-1.5 grid h-5 w-5 flex-none place-items-center rounded-full bg-gradient-to-br from-violet-500 via-fuchsia-500 to-cyan-500 shadow-[0_0_14px_rgba(168,85,247,0.55)]"
              >
                <svg viewBox="0 0 12 12" class="h-2.5 w-2.5 text-white" fill="none">
                  <path
                    d="M2.5 6.2 5 8.7l4.5-5"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <span class="text-sm leading-relaxed text-slate-700 sm:text-base dark:text-slate-300">
                {point}
              </span>
            </li>
          ))
        }
      </ul>

      <!-- Buttons -->
      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="https://synctune-frontend.vercel.app"
          target="_blank"
          rel="noopener"
          class="btn-primary"
        >
          Open Website
          <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" aria-hidden="true">
            <path d="M7 13 13 7M8 7h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a
          href="https://github.com/sudjairakc/synctune-frontend"
          target="_blank"
          rel="noopener"
          class="btn-ghost"
        >
          Frontend Repo
        </a>
        <a
          href="https://github.com/sudjairakc/synctune-backend"
          target="_blank"
          rel="noopener"
          class="btn-ghost"
        >
          Backend Repo
        </a>
      </div>
    </div>

    <!-- ── RIGHT: media-player mockup ─────────────────────────────────── -->
    <div class="relative isolate mx-auto w-full max-w-md lg:max-w-none">
      <!-- Layered glow blobs (violet / cyan / pink) -->
      <div
        aria-hidden="true"
        class="blob float-slower pointer-events-none absolute -left-10 -top-12 -z-10 h-56 w-56 rounded-full bg-violet-500/40 opacity-70 blur-3xl dark:bg-violet-500/30"
      >
      </div>
      <div
        aria-hidden="true"
        class="blob pointer-events-none absolute -right-12 top-1/3 -z-10 h-60 w-60 rounded-full bg-cyan-400/40 opacity-70 blur-3xl dark:bg-cyan-400/25"
      >
      </div>
      <div
        aria-hidden="true"
        class="blob float-slow pointer-events-none absolute -bottom-14 left-1/4 -z-10 h-56 w-56 rounded-full bg-pink-500/40 opacity-70 blur-3xl dark:bg-pink-500/25"
      >
      </div>

      <!-- The player panel -->
      <div class="glass float-slower relative overflow-hidden p-6 sm:p-7" aria-hidden="true">
        <!-- Header row -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="grid h-8 w-8 place-items-center rounded-xl bg-gradient-to-br from-violet-500 to-cyan-500 text-white shadow-[0_0_16px_rgba(139,92,246,0.5)]">
              <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor">
                <path d="M7 3v9.6a3 3 0 1 0 1.5 2.6V7l7-1.6V11a3 3 0 1 0 1.5 2.6V3L7 4.6Z" />
              </svg>
            </span>
            <span class="text-sm font-semibold tracking-tight text-slate-900 dark:text-white">Room 482913</span>
          </div>
          <span class="pill text-xs">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>
            3 listeners online
          </span>
        </div>

        <!-- Now playing -->
        <div class="mt-6 flex items-center gap-3">
          <div class="relative h-14 w-24 flex-none overflow-hidden rounded-xl bg-gradient-to-br from-violet-500 via-fuchsia-500 to-cyan-400 shadow-lg">
            <span class="absolute inset-0 grid place-items-center">
              <svg viewBox="0 0 24 24" class="h-6 w-6 text-white/90" fill="currentColor">
                <path d="M9 8v8l7-4-7-4Z" />
              </svg>
            </span>
          </div>
          <div class="min-w-0">
            <p class="text-[0.7rem] font-medium uppercase tracking-widest text-slate-400 dark:text-slate-500">Now playing</p>
            <p class="truncate text-sm font-semibold text-slate-900 dark:text-white">Shared YouTube queue</p>
          </div>
        </div>

        <!-- Equalizer + play button -->
        <div class="mt-6 flex items-center gap-4">
          <!-- Glowing round play button -->
          <span class="relative flex-none">
            <span class="absolute inset-0 animate-ping rounded-full bg-violet-500/40"></span>
            <span class="relative grid h-14 w-14 place-items-center rounded-full bg-gradient-to-br from-violet-500 to-cyan-400 text-white shadow-[0_0_28px_rgba(139,92,246,0.65)]">
              <svg viewBox="0 0 24 24" class="ml-0.5 h-6 w-6" fill="currentColor">
                <path d="M8 6v12l10-6L8 6Z" />
              </svg>
            </span>
          </span>

          <!-- Waveform -->
          <div class="flex h-14 flex-1 items-end gap-[3px]">
            {
              bars.map((h, i) => (
                <span
                  class={`float-slow w-full rounded-full bg-gradient-to-t from-cyan-400 to-violet-500 ${i % 3 === 0 ? "opacity-100" : "opacity-80"}`}
                  style={`height:${h}%;animation-delay:${(i % 6) * 0.18}s`}
                />
              ))
            }
          </div>
        </div>

        <!-- Progress bar -->
        <div class="mt-5">
          <div class="h-1.5 w-full overflow-hidden rounded-full bg-slate-200/70 dark:bg-white/10">
            <div class="h-full w-2/5 rounded-full bg-gradient-to-r from-violet-500 via-fuchsia-500 to-cyan-400"></div>
          </div>
          <div class="mt-1.5 flex justify-between text-[0.65rem] font-medium text-slate-400 dark:text-slate-500">
            <span>1:42</span>
            <span>4:05</span>
          </div>
        </div>

        <!-- Mini queue -->
        <div class="mt-6">
          <p class="mb-2 text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500">Up next</p>
          <ul class="space-y-2">
            {
              queue.map((t) => (
                <li class="flex items-center gap-3 rounded-xl bg-white/40 px-2.5 py-2 dark:bg-white/5">
                  <span class={`h-8 w-8 flex-none rounded-lg bg-gradient-to-br ${t.from} ${t.to}`} />
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-xs font-medium text-slate-700 dark:text-slate-200">{t.title}</span>
                    <span class="block h-1.5 w-1/2 rounded-full bg-slate-200/80 dark:bg-white/10" />
                  </span>
                  <span class="flex items-center gap-1 rounded-full bg-violet-500/10 px-2 py-0.5 text-[0.7rem] font-semibold text-violet-600 dark:text-violet-300">
                    <svg viewBox="0 0 12 12" class="h-2.5 w-2.5" fill="currentColor">
                      <path d="M6 2 10 8H2L6 2Z" />
                    </svg>
                    {t.votes}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Avatars + footer chips -->
        <div class="mt-6 flex items-center justify-between gap-3">
          <div class="flex -space-x-2">
            {
              avatars.map((a) => (
                <span class={`h-7 w-7 rounded-full border-2 border-white bg-gradient-to-br ${a} dark:border-slate-900`} />
              ))
            }
          </div>
          <div class="flex flex-wrap justify-end gap-1.5">
            <span class="pill text-[0.7rem]">Vote skip</span>
            <span class="pill text-[0.7rem]">SoundPad</span>
            <span class="pill text-[0.7rem]">Push-to-talk</span>
          </div>
        </div>
      </div>

      <!-- Floating chat bubbles -->
      <div
        aria-hidden="true"
        class="float-slow glass absolute -right-3 top-6 hidden rounded-2xl px-3 py-2 text-xs font-medium text-slate-700 shadow-lg sm:block dark:text-slate-200"
      >
        nice track 🔥
      </div>
      <div
        aria-hidden="true"
        class="float-slower glass absolute -left-4 bottom-10 hidden rounded-2xl px-3 py-2 text-xs font-medium text-slate-700 shadow-lg sm:block dark:text-slate-200"
      >
        add lofi next 🎧
      </div>
    </div>
  </div>
</section>
