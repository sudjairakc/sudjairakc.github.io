---
import "../styles/global.css";
import { site, socials } from "@data/site";
import { projects } from "@data/projects";
import { getContent } from "@data/i18n";

interface Props {
  title?: string;
  description?: string;
  lang?: "en" | "th";
}

const { lang = "en" } = Astro.props;
const t = getContent(lang);
const { title = t.meta.title, description = t.meta.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;

// Language alternates (en = root, th = /th/).
const enHref = new URL("/", site.url).href;
const thHref = new URL("/th/", site.url).href;
const ogLocale = lang === "th" ? "th_TH" : "en_US";

// ── AEO / SEO: schema.org structured data (JSON-LD) ─────────────────────────
// Person + WebSite + an ItemList of projects so answer engines (and search)
// can extract who this is, what they do, and what they've built.
const personId = `${site.url}#person`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: site.name,
      alternateName: site.displayName,
      jobTitle: t.common.role,
      description: description,
      url: site.url,
      email: `mailto:${socials.email}`,
      nationality: "Thai",
      address: { "@type": "PostalAddress", addressCountry: "TH" },
      sameAs: [
        socials.github,
        socials.linkedin,
        socials.gitlab,
        socials.facebook,
      ],
      knowsAbout: [
        "Full Stack Development",
        "Artificial Intelligence",
        "Web Development",
        "Data Visualization",
        "Real-time Systems",
        "TypeScript",
        "Go",
        "React",
        "Svelte",
        "Astro",
        "Node.js",
        "WebSocket",
        "WebRTC",
        "Redis",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${site.url}#website`,
      name: title,
      description: description,
      url: site.url,
      inLanguage: lang,
      author: { "@id": personId },
      publisher: { "@id": personId },
    },
    {
      "@type": "ItemList",
      name: "Selected Projects",
      itemListOrder: "https://schema.org/ItemListOrderAscending",
      itemListElement: projects.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "SoftwareApplication",
          name: t.projects[i]?.shortTitle ?? p.shortTitle,
          description: t.projects[i]?.description ?? p.description,
          url: p.website,
          applicationCategory: "WebApplication",
          operatingSystem: "Web",
          author: { "@id": personId },
          keywords: p.stack.join(", "),
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Language alternates -->
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="th" href={thHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site.url} />
    <meta property="og:image" content={new URL(site.ogImage, site.url).href} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="author" content={site.name} />
    <meta
      name="keywords"
      content="Chaichana Sudjairak, James, Senior Full-Stack Developer, AI Developer, Astro, Svelte, Go, TypeScript, data visualization, real-time systems, Thailand"
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- AEO/SEO: structured data for search + answer engines -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />

    <!-- Fonts: Inter (English) + Noto Sans Thai (Thai) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Set theme before paint to avoid a flash of the wrong mode. -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body>
    <slot />

    <!-- Scroll reveal: fade-up elements tagged `.reveal` as they enter view. -->
    <script is:inline>
      (() => {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const els = document.querySelectorAll(".reveal");
        if (reduce || !("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
